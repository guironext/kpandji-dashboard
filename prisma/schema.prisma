  plaquesImmatriculation   Boolean @default(false)

  // 3. Pneumatiques
  pressionCorrecte      Boolean @default(false)
  usureReguliere        Boolean @default(false)
  roueSecoursPresente   Boolean @default(false)
  cricPresent           Boolean @default(false)
  cleRouePresente       Boolean @default(false)

  // 4. Compartiment moteur
  niveauHuileMoteur         Boolean @default(false)
  liquideRefroidissement    Boolean @default(false)
  liquideFrein              Boolean @default(false)
  liquideDirectionAssistee  Boolean @default(false)
  liquideLaveGlace          Boolean @default(false)
  batterie                  Boolean @default(false)
  courroies                 Boolean @default(false)
  absenceFuite              Boolean @default(false)

  // 5. Habitacle
  tableauBord            Boolean @default(false)
  temoinsAllumes         Boolean @default(false)
  climatisation          Boolean @default(false)
  chauffage              Boolean @default(false)
  klaxon                 Boolean @default(false)
  ceinturesSecurite      Boolean @default(false)
  sieges                 Boolean @default(false)
  leveVitres             Boolean @default(false)
  verrouillageCentralise Boolean @default(false)
  autoradio              Boolean @default(false)

  // 6. Électricité
  feuxPosition       Boolean @default(false)
  feuxCroisement     Boolean @default(false)
  feuxRoute          Boolean @default(false)
  clignotants        Boolean @default(false)
  feuxStop           Boolean @default(false)
  feuxRecul          Boolean @default(false)
  feuxAntibrouillard Boolean @default(false)

  // 7. Contrôle mécanique
  controleMoteur       Boolean @default(false)
  controleEmbrayage    Boolean @default(false)
  controleBoiteVitesses Boolean @default(false)
  controleDirection    Boolean @default(false)
  controleSuspension   Boolean @default(false)
  controleFreinage     Boolean @default(false)
  controleTransmission Boolean @default(false)

  // 8. Essai routier
  demarrageNormal        Boolean @default(false)
  accelerationCorrecte   Boolean @default(false)
  freinageEfficace       Boolean @default(false)
  directionStable        Boolean @default(false)
  absenceVibrations      Boolean @default(false)
  absenceBruitAnormal    Boolean @default(false)

  // 9. Accessoires remis par le client
  cle1                  Boolean @default(false)
  cle2                  Boolean @default(false)
  carteGrise            Boolean @default(false)
  accessoireRoueSecours Boolean @default(false)
  accessoireCric        Boolean @default(false)
  trousseOutils         Boolean @default(false)
  giletSecurite         Boolean @default(false)
  triangleSignalisation Boolean @default(false)

  // 10. Observations
  observations String? @db.Text

  voitureSAVId String
  voitureSAV   VoitureSAV @relation(fields: [voitureSAVId], references: [id], onDelete: Cascade)
  redacteurId  String?
  redacteur    User?      @relation(fields: [redacteurId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([voitureSAVId])
  @@index([statut])
}

