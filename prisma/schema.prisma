generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                 String                              @id @default(uuid())
  clerkId                            String                              @unique
  email                              String                              @unique
  firstName                          String
  lastName                           String
  role                               UserRole                            @default(EMPLOYEE)
  department                         String?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  telephone                          String?
  CalendrierSortie                   CalendrierSortie[]
  Client                             Client[]
  Client_entreprise                  Client_entreprise[]
  CommunicationProject               CommunicationProject[]
  Employee                           Employee[]
  Facture                            Facture[]
  ReceivedMessages                   Message[]                           @relation("ReceivedMessages")
  SentMessages                       Message[]                           @relation("SentMessages")
  NumeroCourrier                     NumeroCourrier[]
  ObjectifCible                      ObjectifCible[]
  ObjectifPeriod                     ObjectifPeriod[]
  ObjectifPole                       ObjectifPole[]
  Objectifsfinancieres               Objectifsfinancieres[]
  Objectifsprospects                 Objectifsprospects[]
  Objectifsvehicules                 Objectifsvehicules[]
  Paiement                           Paiement[]
  ReservationVehicule                ReservationVehicule[]
  Signature                          Signature?
  Tableau_chute                      Tableau_chute[]
  Tableau_chute_rendez_vous          Tableau_chute_rendez_vous[]
  NotificationsSent                  Notification[]                      @relation("NotificationsSent")
  NotificationsReceived              Notification[]                      @relation("NotificationsReceived")
  Agenda                             Agenda[]
  RapportActiviteAgenda              RapportActiviteAgenda[]
  RapportMaintenanceSAV              RapportMaintenanceSAV[]
  CheckListsSAV                      CheckListsSAV[]
  objectifPrincipauxes               ObjectifPrincipaux[]
  RubriqueObjectifGlobal             RubriqueObjectifGlobal[]
  ObjectifGlobal                     ObjectifGlobal[]
  publicationObjectifGlobalRubriques PublicationObjectifGlobalRubrique[]
  JournalPublication                 JournalPublication[]
  DossierContentieux                 DossierContentieux[]
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String?
  content    String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  receiver   User?     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Client {
  id                String              @id @default(uuid())
  nom               String
  email             String?
  telephone         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  userId            String
  commercial        String?
  entreprise        String?
  localisation      String?
  secteur_activite  String?
  status_client     StatusClient        @default(PROSPECT)
  premiere_commande Boolean             @default(false)
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  Commande          Commande[]
  Facture           Facture[]
  Paiement          Paiement[]
  RapportRendezVous RapportRendezVous[]
  rendezVous        RendezVous[]
  Tableau_chute     Tableau_chute[]
  Voiture           Voiture[]
}

model RendezVous {
  id                  String                @id @default(uuid())
  date                DateTime
  resume_rendez_vous  String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  statut              RendezVousStatut      @default(EN_ATTENTE)
  note                String?
  clientId            String?
  clientEntrepriseId  String?
  CalendrierSortie    CalendrierSortie[]
  RapportRendezVous   RapportRendezVous[]
  Client_entreprise   Client_entreprise?    @relation(fields: [clientEntrepriseId], references: [id], onDelete: Cascade)
  client              Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ReservationVehicule ReservationVehicule[]
  Voiture             Voiture[]
}

model Conteneur {
  id                    String                  @id @default(uuid())
  conteneurNumber       String                  @unique
  sealNumber            String?
  totalPackages         String?
  grossWeight           String?
  netWeight             String?
  stuffingMap           String?
  dateEmbarquement      DateTime?
  dateArriveProbable    DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  etapeConteneur        EtapeConteneur          @default(EN_ATTENTE)
  isVerified            Boolean                 @default(false)
  Commande              Commande[]
  CourrieAvantage       CourrieAvantage[]
  Subcase               Subcase[]
  VerificationConteneur VerificationConteneur[]
  Voiture               Voiture[]
}

model Montage {
  id                                    String             @id @default(uuid())
  createdAt                             DateTime           @default(now())
  updatedAt                             DateTime           @updatedAt
  no_chassis                            String?
  commandeId                            String
  etapeMontage                          EtapeMontage       @default(CREATION)
  ordreMontageId                        String?
  Attribution                           Attribution[]
  Commande_Commande_montageIdToMontage  Commande?          @relation("Commande_montageIdToMontage")
  Equipe                                Equipe[]
  Commande_Montage_commandeIdToCommande Commande           @relation("Montage_commandeIdToCommande", fields: [commandeId], references: [id])
  OrdreMontage                          OrdreMontage?      @relation(fields: [ordreMontageId], references: [id])
  MontageSparePart                      MontageSparePart[]
  RapportMontage                        RapportMontage[]
}

model Equipe {
  id                          String                        @id @default(uuid())
  nomEquipe                   String
  chefEquipeId                String
  activite                    String
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  montageId                   String?
  mission                     String
  taches_accomplies           String
  stautsEquipe                StatusEquipe                  @default(ACTIVE)
  Attribution                 Attribution[]
  Employee                    Employee                      @relation(fields: [chefEquipeId], references: [id])
  Montage                     Montage?                      @relation(fields: [montageId], references: [id])
  EquipeMembre                EquipeMembre[]
  MontageSparePartAttribution MontageSparePartAttribution[]
  RapportEquipe               RapportEquipe[]
  MontageSparePart            MontageSparePart[]
}

model Accessoire {
  id          String    @id @default(uuid())
  nom         String
  voitureId   String?
  factureId   String?
  commandeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  image       String?
  description String?
  prix        Decimal?
  quantity    Int?      @default(1)
  Commande    Commande? @relation(fields: [commandeId], references: [id])
  Facture     Facture?  @relation(fields: [factureId], references: [id])
  Voiture     Voiture?  @relation(fields: [voitureId], references: [id])
}

model Attribution {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  sparePartId    String
  quantity       Int
  equipeId       String
  montageId      String
  ordreMontageId String
  Equipe         Equipe       @relation(fields: [equipeId], references: [id])
  Montage        Montage      @relation(fields: [montageId], references: [id])
  OrdreMontage   OrdreMontage @relation(fields: [ordreMontageId], references: [id])
  SparePart      SparePart    @relation(fields: [sparePartId], references: [id])
}

model BonDeCommande {
  id                     String              @id
  createdAt              DateTime            @default(now())
  updatedAt              DateTime
  numero                 String
  factureId              String              @unique
  prefix_numero          String
  Facture                Facture             @relation(fields: [factureId], references: [id])
  status_bon_de_commande StatusBonDeCommande @default(EN_ATTENTE)
}

//set status_bon_de_commande=VALIDE_APPORT_INITIAL when facture.prix_unitaire*facture.nbr_voiture_commande*0.60 is greater than facture.total_ttc

enum StatusBonDeCommande {
  EN_ATTENTE
  SOUS_RESERVE
  VALIDE
  VALIDE_APPORT_INITIAL
  ANNULE
}

model BonPourAccord {
  id                     String              @id @default(uuid())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  numero_bon_pour_accord String
  factureId              String              @unique
  Facture                Facture             @relation(fields: [factureId], references: [id])
  status_bon_pour_accord StatusBonPourAccord @default(EN_ATTENTE)
}

enum StatusBonPourAccord {
  EN_ATTENTE
  SOUS_RESERVE
  VALIDE
  VALIDE_APPORT_INITIAL
  ANNULE
}

model LettreCommande {
  id                       String   @id @default(uuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  numero_lettre_commande   String
  validite_lettre_commande Boolean  @default(false)

  factureId                 String                      @unique
  Facture                   Facture                     @relation(fields: [factureId], references: [id])
  Evolution_Lettre_Commande Evolution_Lettre_Commande[]
}

model Evolution_Lettre_Commande {
  id                String         @id @default(uuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  etape_actuelle    String
  etape_suivante    String
  lettre_commandeId String
  LettreCommande    LettreCommande @relation(fields: [lettre_commandeId], references: [id], onDelete: Cascade)

  @@index([lettre_commandeId])
}

model AppelOffre {
  id                      String                    @id @default(uuid())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  numero_appel_offre      String
  validite_appel_offre    Boolean                   @default(false)
  factureId               String                    @unique
  Facture                 Facture                   @relation(fields: [factureId], references: [id])
  Information_Appel_Offre Information_Appel_Offre[]
  Evolution_Appel_Offre   Evolution_Appel_Offre[]
}

model Information_Appel_Offre {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  nomStrctureEmettrice String
  domaineActivite String
  telephone String
  email String
  numeroAppelOffre String
  appel_offreId  String
  AppelOffre     AppelOffre @relation(fields: [appel_offreId], references: [id], onDelete: Cascade)
  listeDocuments Document[]
}
model Document {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  nomDocument String
  urlDocument String
  information_appel_offreId String
  Information_Appel_Offre Information_Appel_Offre @relation(fields: [information_appel_offreId], references: [id], onDelete: Cascade)
}
model Evolution_Appel_Offre {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  etape_actuelle String
  etape_suivante String
  appel_offreId  String
  AppelOffre     AppelOffre @relation(fields: [appel_offreId], references: [id], onDelete: Cascade)

  @@index([appel_offreId])
}

model Client_entreprise {
  id                           String              @id
  nom_entreprise               String
  sigle                        String?
  email                        String?
  telephone                    String
  nom_personne_contact         String?
  fonction_personne_contact    String?
  email_personne_contact       String?
  telephone_personne_contact   String?
  localisation                 String?
  secteur_activite             String?
  flotte_vehicules             Boolean?
  flotte_vehicules_description String?
  status_client                StatusClient        @default(PROSPECT)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime
  commercial                   String?
  userId                       String
  premiere_commande            Boolean             @default(false)
  User                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  Commande                     Commande[]
  Facture                      Facture[]
  Paiement                     Paiement[]
  RapportRendezVous            RapportRendezVous[]
  RendezVous                   RendezVous[]
  Tableau_chute                Tableau_chute[]
  Voiture                      Voiture[]
}

model Commande {
  id                                   String             @id
  etapeCommande                        EtapeCommande
  date_livraison                       DateTime
  createdAt                            DateTime           @default(now())
  updatedAt                            DateTime
  clientId                             String?
  conteneurId                          String?
  commandeLocalId                      String?
  couleur                              String
  montageId                            String?            @unique
  motorisation                         Motorisation
  nbr_portes                           String
  transmission                         Transmission
  voitureModelId                       String?
  clientEntrepriseId                   String?
  factureId                            String?
  prix_unitaire                        Decimal?
  commandeFlag                         CommandeFlag       @default(VENDUE)
  commandeGroupeeId                    String?
  numChassis                           String?
  Accessoire                           Accessoire[]
  Client_entreprise                    Client_entreprise? @relation(fields: [clientEntrepriseId], references: [id], onDelete: Cascade)
  Client                               Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  CommandeGroupee                      CommandeGroupee?   @relation(fields: [commandeGroupeeId], references: [id])
  CommandeLocal                        CommandeLocal?     @relation(fields: [commandeLocalId], references: [id])
  Conteneur                            Conteneur?         @relation(fields: [conteneurId], references: [id])
  Facture                              Facture?           @relation(fields: [factureId], references: [id])
  Montage_Commande_montageIdToMontage  Montage?           @relation("Commande_montageIdToMontage", fields: [montageId], references: [id])
  VoitureModel                         VoitureModel?      @relation(fields: [voitureModelId], references: [id])
  CommandeEnAttente                    CommandeEnAttente?
  Correction                           Correction[]
  CourrieAvantage                      CourrieAvantage[]
  Montage_Montage_commandeIdToCommande Montage[]          @relation("Montage_commandeIdToCommande")
  OrdreMontage                         OrdreMontage[]
  SparePart                            SparePart[]
  Teste                                Teste[]
  Tool                                 Tool[]
  Voiture                              Voiture[]
  Fournisseur                          Fournisseur[]
  typeCommandeId                       String?
  TypeCommande                         TypeCommande?      @relation(fields: [typeCommandeId], references: [id])
}

model TypeCommande {
  id        String          @id
  createdAt DateTime        @default(now())
  updatedAt DateTime
  nom       TypeCommandeNom @default(PERSON_INDIVIDUEL)
  Commande  Commande[]
}

model CommandeEnAttente {
  id                   String        @id
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  commandeId           String        @unique
  voitureModelId       String?
  qteCommandeEnAttente Int
  Commande             Commande      @relation(fields: [commandeId], references: [id])
  VoitureModel         VoitureModel? @relation(fields: [voitureModelId], references: [id])
}

model CommandeGroupee {
  id                   String               @id
  date_validation      DateTime
  stock_global         String
  vendue               String
  details              String
  stock_disponible     String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  etapeCommandeGroupee EtapeCommandeGroupee @default(VALIDE)
  Commande             Commande[]
}

model CommandeLocal {
  id                       String                     @id
  article                  String
  description              String
  quantity                 Int
  price                    Decimal
  total                    Decimal
  date_livraison           DateTime
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  Commande                 Commande[]
  PieceComplement          PieceComplement[]
  SparePart                SparePart[]
  Tool                     Tool[]
  Voiture                  Voiture[]
  FournisseurCommandeLocal FournisseurCommandeLocal[]
}

model Correction {
  id                String              @id
  details           String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  voitureId         String
  commandeId        String?
  Commande          Commande?           @relation(fields: [commandeId], references: [id])
  Voiture           Voiture             @relation(fields: [voitureId], references: [id])
  RapportCorrection RapportCorrection[]
  SparePart         SparePart[]
  Tool              Tool[]
}

model CourrieAvantage {
  id               String    @id
  date_livraison   DateTime
  reference        String
  numero_conteneur String
  vin              String
  moteur           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  conteneurId      String
  commandeId       String?
  Commande         Commande? @relation(fields: [commandeId], references: [id])
  Conteneur        Conteneur @relation(fields: [conteneurId], references: [id])
}

model Employee {
  id                         String                     @id
  nom                        String
  prenoms                    String
  numro_matricule            String?
  contact                    String
  bloodType                  String?
  specialite                 String
  poste                      String?
  email                      String?
  adresse                    String?
  image                      String?
  personne_urgence           String?
  telephone_personne_urgence String?
  relation_personne_urgence  String?
  date_Embauche              DateTime?
  date_Depart                DateTime?
  status                     StatusEmployee             @default(ACTIVE)
  userId                     String
  User                       User                       @relation(fields: [userId], references: [id])
  Equipe                     Equipe[]
  EquipeMembre               EquipeMembre[]
  LocalBuy                   LocalBuy[]
  Teste                      Teste[]
  Pointage                   Pointage[]
  Nomination_vote_Employee   Nomination_vote_Employee[]
  Permission                 Permission[]
  CongeAnnuel                CongeAnnuel[]
}

enum StatusEmployee {
  ACTIVE
  INACTIVE
  EN_COURS_DE_DEMISSION
  DEMISSIONNE
  EN_COURS_DE_REINTEGRATION
  REINTEGRE
  EN_COURS_DE_FORMATION
  FORMEE
  CONGE_ANNUEL
  CONGE_MATERNITE
  CONGE_PATERNITE
}

model Pointage {
  id           String   @id
  date         DateTime
  heure_entree DateTime
  heure_sortie DateTime
  employeeId   String
  Employee     Employee @relation(fields: [employeeId], references: [id])
}

model Nomination_vote_Employee {
  id          String   @id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employeeId  String
  datedebut   DateTime
  datefin     DateTime
  titre       String
  description String
  Employee    Employee @relation(fields: [employeeId], references: [id])
}

model Permission {
  id          String           @id
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employeeId  String
  datedebut   DateTime
  datefin     DateTime
  titre       StatusPermission
  description String
  Employee    Employee         @relation(fields: [employeeId], references: [id])
}

enum StatusPermission {
  EN_ATTENTE
  VALIDE
  EN_COURS
  TERMINEE
  ANNULE
}

model CongeAnnuel {
  id         String            @id
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  employeeId String
  datedebut  DateTime
  datefin    DateTime
  status     StatusCongeAnnuel @default(EN_ATTENTE)
  Employee   Employee          @relation(fields: [employeeId], references: [id])
}

enum StatusCongeAnnuel {
  EN_ATTENTE
  VALIDE
  EN_COURS
  TERMINEE
  ANNULE
}

model EquipeMembre {
  id         String   @id
  qualite    Qualite
  fonction   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  equipeId   String
  employeeId String
  Employee   Employee @relation(fields: [employeeId], references: [id])
  Equipe     Equipe   @relation(fields: [equipeId], references: [id])
}

model Facture {
  id                     String             @id
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  clientId               String?
  clientEntrepriseId     String?
  userId                 String
  date_facture           DateTime
  date_echeance          DateTime
  status_facture         StatusFacture      @default(EN_ATTENTE)
  voitureId              String?
  nbr_voiture_commande   Int
  prix_unitaire          Decimal
  montant_ht             Decimal
  total_ht               Decimal
  remise                 Decimal
  montant_remise         Decimal
  montant_net_ht         Decimal
  tva                    Decimal
  montant_tva            Decimal
  total_ttc              Decimal
  avance_payee           Decimal
  reste_payer            Decimal
  accessoire_description String?
  accessoire_nbr         Int?
  accessoire_nom         String?
  accessoire_prix        Decimal?
  accessoire_subtotal    Decimal?
  bon_pour_acquis        Boolean            @default(false)
  notes_proforma         String?
  Accessoire             Accessoire[]
  BonDeCommande          BonDeCommande?
  BonPourAccord          BonPourAccord?
  LettreCommande         LettreCommande?
  AppelOffre             AppelOffre?
  Commande               Commande[]
  Client_entreprise      Client_entreprise? @relation(fields: [clientEntrepriseId], references: [id], onDelete: Cascade)
  Client                 Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User                   User               @relation(fields: [userId], references: [id])
  Voiture                Voiture?           @relation(fields: [voitureId], references: [id])
  FactureLigne           FactureLigne[]
  Paiement               Paiement[]
}

model FactureLigne {
  id             String       @id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  factureId      String
  voitureModelId String
  couleur        String
  nbr_voiture    Int
  prix_unitaire  Decimal
  montant_ligne  Decimal
  motorisation   String?
  transmission   String?
  Facture        Facture      @relation(fields: [factureId], references: [id], onDelete: Cascade)
  VoitureModel   VoitureModel @relation(fields: [voitureModelId], references: [id])
}

model Fournisseur {
  id            String     @id
  nom           String
  email         String?
  telephone     String?
  adresse       String?
  ville         String?
  code_postal   String?
  pays          String?
  type_Activite String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  Commande      Commande[]
}

model Partenaire {
  id              String         @id
  nom             String
  email           String?
  telephone       String?
  adresse         String?
  ville           String?
  code_postal     String?
  pays            String?
  type_partenaire TypePartenaire
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
}

enum TypePartenaire {
  FOURNISSEUR
  CLIENT
  PARTENAIRE
}

model FournisseurCommandeLocal {
  id              String          @id
  nom             String
  email           String?
  telephone       String?
  adresse         String?
  ville           String?
  code_postal     String?
  pays            String?
  type_Activite   String?
  commandeLocalId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  CommandeLocal   CommandeLocal[]
}

model LocalBuy {
  id             String   @id
  partName       String
  partNameFrench String?
  partCode       String
  quantity       Int
  price          Float?
  description    String?
  montant        Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  employeeId     String
  Employee       Employee @relation(fields: [employeeId], references: [id])
}

model MontageSparePart {
  id                          String                        @id
  qte_commandee               String?
  qte_attribue                String?
  qte_restante                String?
  equipe_montage              String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  montageId                   String
  Montage                     Montage                       @relation(fields: [montageId], references: [id])
  MontageSparePartAttribution MontageSparePartAttribution[]
  Equipe                      Equipe[]
  SparePart                   SparePart[]
  Tool                        Tool[]
}

model MontageSparePartAttribution {
  id                 String           @id
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  equipeId           String
  montageSparePartId String
  Equipe             Equipe           @relation(fields: [equipeId], references: [id])
  MontageSparePart   MontageSparePart @relation(fields: [montageSparePartId], references: [id])
  SparePart          SparePart[]
}

model NumeroChassis {
  id              String         @id
  chassisNumber   String         @unique
  motorisation    Motorisation
  numeroConteneur String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  chassisFlag     ChassisFlag    @default(DISPONIBLE)
  OrdreMontage    OrdreMontage[]
}

model NumeroEntreeCaisse {
  id            String   @id
  numero        String   @unique
  prefix_numero String
  paiementId    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Paiement      Paiement @relation(fields: [paiementId], references: [id])
}

model OrdreMontage {
  id               String           @id
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  commandeId       String
  voitureId        String
  numeroChassisId  String
  ordreMontageFlag OrdreMontageFlag @default(CREER)
  Attribution      Attribution[]
  Montage          Montage[]
  Commande         Commande         @relation(fields: [commandeId], references: [id])
  NumeroChassis    NumeroChassis    @relation(fields: [numeroChassisId], references: [id])
  Voiture          Voiture          @relation(fields: [voitureId], references: [id])
}

model Paiement {
  id                 String              @id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  factureId          String
  clientId           String?
  clientEntrepriseId String?
  userId             String
  avance_payee       Decimal
  reste_payer        Decimal
