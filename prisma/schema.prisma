  prospectReel  Int      @default(0)
  tauxAtteint   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  period ObjectifPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodId, userId])
  @@index([userId])
  @@index([periodId])
}

