  date                   DateTime @default(now())
  numeroOrdreReparation  String?
  nomClient              String?
  telephone              String?
  marque                 String?
  modele                 String?
  immatriculation        String?
  numeroChassis          String?
  kilometrage            Int?
  niveauCarburant        String?

  // 2. État extérieur
  pareBrise                Boolean @default(false)
  vitresLaterales          Boolean @default(false)
  lunetteArriere           Boolean @default(false)
  capot                    Boolean @default(false)
  pareChocsAvant           Boolean @default(false)
