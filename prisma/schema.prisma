model CommunicationProject {
  id                    String                      @id @default(uuid())
  name                  String
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  createdById           String?
  createdBy             User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // 1. Analyse de la situation (diagnostic)
  diagnosticContext     String? // Contexte, problème ou besoin
  diagnosticTarget      String? // Cible (public visé)
  diagnosticEnvironment String? // Environnement (concurrence, marché, image)
  diagnosticForces      String? // Forces / faiblesses
  // 2. Définition des objectifs (SMART)
  objectives            String? // Objectifs clairs et mesurables
  // 3. Stratégie
  strategyPositioning   String? // Positionnement et message principal
  strategyTargets       String? // Cibles prioritaires
  strategyChannels      String? // Canaux (réseaux sociaux, affichage, etc.)
  // 4. Plan d'action
  actionPlan            String? // Actions à réaliser
  actionSupports        String? // Supports (affiches, vidéos, posts…)
  actionCalendar        String? // Calendrier
  actionBudget          String? // Budget et responsabilités
  // 5. Mise en œuvre
  implementationContent String? // Création des contenus
  implementationLaunch  String? // Lancement des campagnes
  implementationTeams   String? // Coordination des équipes
  // 6. Évaluation
  evaluationMetrics     String? // Mesure d'efficacité (stats, retours, ventes)
  evaluationComparison  String? // Comparaison avec objectifs
  evaluationAdjustments String? // Ajustements
  projectStatus         ProjectStatus               @default(ACTIVE)
  planActions           CommunicationPlanAction[]
  actors                CommunicationProjectActor[]
  budgetItems           CommunicationBudgetItem[]
}

model CommunicationPlanAction {
  id         String               @id @default(uuid())
  projectId  String
  project    CommunicationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String // Action label
  startDate  DateTime // Start date/time
  endDate    DateTime // End date/time
  completed  Boolean              @default(false) // Whether the action is done
  orderIndex Int                  @default(0) // Display order
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([projectId])
}

model CommunicationProjectActor {
  id         String               @id @default(uuid())
  projectId  String
  project    CommunicationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String // Actor name
  department String // Department
  job        String // Job/role they are dealing with
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([projectId])
}

model CommunicationBudgetItem {
  id          String               @id @default(uuid())
  projectId   String
  project     CommunicationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designation String // Item description
  prixUnitaire Float // Unit price
  quantite    Float // Quantity
  montant     Float // Amount (prixUnitaire * quantite)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
}


/// Objectifs commerciaux 
model ObjectifPeriod{
  id String @id @default(uuid())
  objectif_start DateTime
  objectif_end DateTime
  objectif_duree String
  objectifs_financieres String
  objectifs_vehicules String
  objectifs_clients String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  userId String
